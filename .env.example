# Supabase (used by @nuxtjs/supabase module, scripts, and server routes)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alias used in some server routes
SUPABASE_SERVICE_KEY=

# Anthropic (blog generation script & nuxt runtimeConfig)
ANTHROPIC_API_KEY=

# Cron secret (nuxt runtimeConfig)
CRON_SECRET=

# Cloudflare R2 (server/utils/cloudflare.ts)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Database direct connection (admin_utils/create_sitemap.js)
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# Gmail (blog generation email notifications)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Places API (supabase/functions/discover-cafes)
GOOGLE_PLACES_API_KEY=

# Optional flags
# DRY_RUN=true
